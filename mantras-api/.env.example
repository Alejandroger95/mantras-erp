# ── Base de datos ─────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mantrasdb

# ── JWT ───────────────────────────────────────────────────
# Genera uno seguro: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_de_al_menos_48_caracteres_en_produccion
JWT_EXPIRES_IN=7d

# ── Servidor ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ─────────────────────────────────────────────────
# URLs del frontend separadas por coma
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:4000
